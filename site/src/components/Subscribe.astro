---
/**
 * The letter sign-up.
 *
 * Posts to /api/subscribe, a Cloudflare Pages Function in functions/ at the
 * repo root. That endpoint holds the provider key, so nothing secret is ever
 * in the page.
 *
 * Works both ways round:
 *   - with JavaScript, the script intercepts and reports inline
 *   - without it, the browser posts the form and the endpoint redirects to
 *     /letter/thank-you/
 *
 * Native validation is deliberately left on — no `novalidate` — so a
 * malformed address is caught by the browser in both cases.
 */
interface Props {
  /** Records which page a sign-up came from. */
  source?: string;
  /** The archive page links to itself otherwise. */
  archiveLink?: boolean;
  /** Drop the standing pitch. For pages that have just made it themselves. */
  compact?: boolean;
}

const { source = "site", archiveLink = true, compact = false } = Astro.props;
---

<section class="section ground-ink on-dark" id="letter">
  <div class="wrap">
    <div class="grid">
      <div class="col-6 subscribe reveal">
        {
          !compact && (
            <>
              <p class="eyebrow">The letter</p>
              <h2 class="h2">One letter, at the end of each month.</h2>
              <p class="lead">
                What we published, what we found, and where we are going next.
                No more than twelve a year.
              </p>
            </>
          )
        }

        <form
          class="subscribe__form"
          action="/api/subscribe"
          method="post"
          data-subscribe
        >
          <label class="visually-hidden" for="email">Email address</label>
          <input
            class="field"
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />

          {/*
            Honeypot. A person never sees this and never fills it; a bot fills
            every field it finds. Submissions carrying it are accepted and
            silently dropped, so the bot learns nothing from the response.
          */}
          <div class="visually-hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input
              id="company"
              name="company"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <input type="hidden" name="source" value={source} />

          <button class="button" type="submit" data-subscribe-submit>
            Subscribe
          </button>
        </form>

        <p
          class="small credit subscribe__status"
          data-subscribe-status
          role="status"
          aria-live="polite"
        >
        </p>

        <p class="small credit">
          One letter a month. Unsubscribe from the foot of any issue.
          {archiveLink && <> <a class="link" href="/letter/">Read past letters</a>.</>}
        </p>
      </div>
    </div>
  </div>
</section>
