---
/**
 * The letter sign-up.
 *
 * Posts to /api/subscribe, a Cloudflare Pages Function in site/functions/.
 * That endpoint holds the provider key, so nothing secret is ever in the page.
 *
 * Works both ways round:
 *   - with JavaScript, the script intercepts and reports inline
 *   - without it, the browser posts the form and the endpoint redirects to
 *     /letter/thank-you/
 *
 * Native validation is deliberately left on — no `novalidate` — so a
 * malformed address is caught by the browser in both cases.
 *
 * THREE STATES. The pitch is what everyone sees and the only one that exists
 * without JavaScript. The other two are revealed by the script when this
 * browser remembers signing up — pending until the address is confirmed,
 * settled after. The site cannot know who a visitor is and does not try: this
 * is a note this browser left itself, and it says so.
 */
interface Props {
  /** Records which page a sign-up came from. */
  source?: string;
  /** The archive page links to itself otherwise. */
  archiveLink?: boolean;
  /** Drop the standing pitch. For pages that have just made it themselves. */
  compact?: boolean;
}

const { source = "site", archiveLink = true, compact = false } = Astro.props;
---

<section class="section ground-ink on-dark" id="letter">
  <div class="wrap">
    <div class="grid">
      <div class="col-6 subscribe reveal" data-letter>
        {/* ---- The offer. The default, and the whole thing without JS ---- */}
        <div class="subscribe__panel" data-letter-offer>
          {
            !compact && (
              <>
                <p class="eyebrow">The letter</p>
                <h2 class="h2">One letter, at the end of each month.</h2>
                <p class="lead">
                  What we published, what we found, and where we are going next.
                </p>
              </>
            )
          }

          <form
            class="subscribe__form"
            action="/api/subscribe"
            method="post"
            data-subscribe
          >
            <label class="visually-hidden" for="email">Email address</label>
            <input
              class="field"
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />

            {/*
              Honeypot. A person never sees this and never fills it; a bot fills
              every field it finds. Submissions carrying it are accepted and
              silently dropped, so the bot learns nothing from the response.

              It used to be called `company`, with a Company label, which was a
              mistake: "company" is a name browsers and password managers
              recognise and autofill, autocomplete="off" is widely ignored, and
              a filled trap silently discards a real person's sign-up. The name
              is now one no autofill heuristic matches, and the endpoint also
              forgives a trap that merely echoes the address — which is exactly
              what autofill does.
            */}
            <div class="visually-hidden" aria-hidden="true">
              <label for="olmi-check">Leave this field empty</label>
              <input
                id="olmi-check"
                name="olmi-check"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <input type="hidden" name="source" value={source} />

            <button class="button" type="submit" data-subscribe-submit>
              Subscribe
            </button>
          </form>

          <p
            class="small credit subscribe__status"
            data-subscribe-status
            role="status"
            aria-live="polite"
          >
          </p>

          <p class="small credit">
            One letter a month. Unsubscribe from the foot of any issue.
            {archiveLink && <> <a class="link" href="/letter/">Read past letters</a>.</>}
          </p>
        </div>

        {/* ---- Signed up here, not yet confirmed ---- */}
        <div class="subscribe__panel" data-letter-state="pending" hidden>
          <p class="eyebrow">The letter</p>
          <h2 class="h2">Check your email.</h2>
          <p class="lead">
            You signed up from this browser. One click in the note we sent
            confirms it, and nothing is sent until you do.
          </p>
          <p class="small credit">
            Remembered on this browser, not by us.{" "}
            <button class="link-button" type="button" data-letter-forget>
              Use a different address
            </button>
          </p>
        </div>

        {/* ---- Confirmed ---- */}
        <div class="subscribe__panel" data-letter-state="confirmed" hidden>
          <p class="eyebrow">The letter</p>
          <h2 class="h2">You are on the list.</h2>
          <p class="lead">
            The next letter reaches you at the end of the month.
          </p>
          <p class="small credit">
            Remembered on this browser, not by us.{" "}
            <button class="link-button" type="button" data-letter-forget>
              Use a different address
            </button>
            {archiveLink && <> · <a class="link" href="/letter/">Past letters</a></>}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
