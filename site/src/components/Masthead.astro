---
import { sections } from "../lib/sections";

/**
 * Site masthead: a thin utility strip, the wordmark, primary navigation, and
 * the two controls that are always reachable — search and the subscribe CTA.
 *
 * The menu panel is not a copy of the desktop nav. On a phone it is the only
 * navigation there is, so it carries the sections, the standing pages and the
 * contact address as well.
 */
interface Props {
  /** Which primary nav item is the current page. */
  current?: string;
  /** Which section slug is the current page, for the strip below. */
  currentSection?: string;
  /** Hide the section strip on pages where it is noise (article pages). */
  showSections?: boolean;
}

const { current, currentSection, showSections = true } = Astro.props;

const NAV = [
  { key: "journal", label: "Journal", href: "/journal/" },
  { key: "sections", label: "Sections", href: "/sections/" },
  { key: "directory", label: "Directory", href: "/directory/" },
  { key: "shop", label: "Shop", href: "/shop/" },
  { key: "seasons", label: "Seasons", href: "/seasons/" },
  { key: "about", label: "About", href: "/about/" },
];

const allSections = await sections();
---

<a class="skip-link" href="#main">Skip to content</a>

<div class="utility">
  <div class="wrap">
    <div class="utility__inner">
      <span class="utility__note">Ordinary Living Made Intentional</span>
      <div class="utility__group">
        <a class="utility__link" href="/letter/">The letter</a>
        <a class="utility__link" href="/directory/">Directory</a>
        <a class="utility__link" href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <div class="masthead__inner">
      <a class="wordmark" href="/">OLMIKAYA</a>

      <nav class="nav" aria-label="Primary">
        {
          NAV.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={item.key === current ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="masthead__actions">
        <button
          class="icon-button"
          type="button"
          data-search-open
          aria-label="Search"
          title="Search  ( / )"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="9" cy="9" r="6" />
            <line x1="13.5" y1="13.5" x2="18" y2="18" />
          </svg>
        </button>

        <a class="button button--sm masthead__cta" href="/letter/">
          Subscribe
        </a>

        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
          <span data-nav-label>Menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="nav-panel" id="nav-panel" data-open="false">
    <div class="wrap">
      <div class="nav-panel__grid">
        <nav aria-label="Primary, mobile">
          <p class="nav-panel__heading">Read</p>
          <ul class="nav-panel__list">
            {
              NAV.map((item) => (
                <li class="nav-panel__item">
                  <a
                    class="nav-panel__link"
                    href={item.href}
                    aria-current={item.key === current ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="nav-panel__item">
              <a class="nav-panel__link" href="/letter/">The letter</a>
            </li>
          </ul>
        </nav>

        {
          allSections.length > 0 && (
            <nav aria-label="Sections, mobile">
              <p class="nav-panel__heading">Sections</p>
              <ul class="nav-panel__tags">
                {allSections.map((s) => (
                  <li class="nav-panel__item">
                    <a class="tag" href={`/sections/${s.slug}/`}>
                      {s.name}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="nav-panel__foot">
          <p class="nav-panel__heading">Elsewhere</p>
          <ul class="nav-panel__minor">
            <li class="nav-panel__item"><a href="/contact/">Contact</a></li>
            <li class="nav-panel__item"><a href="/privacy/">Privacy</a></li>
            <li class="nav-panel__item"><a href="/terms/">Terms</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

{
  showSections && allSections.length > 0 && (
    <div class="subnav">
      <div class="wrap">
        <nav class="subnav__inner" aria-label="Sections">
          <a
            class="subnav__link"
            href="/journal/"
            aria-current={current === "journal" && !currentSection ? "page" : undefined}
          >
            Latest
          </a>
          {allSections.map((s) => (
            <a
              class="subnav__link"
              href={`/sections/${s.slug}/`}
              aria-current={currentSection === s.slug ? "page" : undefined}
            >
              {s.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
  )
}

{/* Native <dialog>: Escape, focus handling and the backdrop come free. */}
<dialog class="search" data-search aria-label="Search OLMIKAYA">
  <form class="search__bar" method="dialog" data-search-form>
    <svg class="search__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="9" cy="9" r="6" />
      <line x1="13.5" y1="13.5" x2="18" y2="18" />
    </svg>
    <label class="visually-hidden" for="search-input">Search</label>
    <input
      class="search__input"
      id="search-input"
      type="search"
      placeholder="Search stories, places, objects"
      autocomplete="off"
      data-search-input
    />
    <button class="icon-button" type="button" data-search-close aria-label="Close search">
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <line x1="5" y1="5" x2="15" y2="15" />
        <line x1="15" y1="5" x2="5" y2="15" />
      </svg>
    </button>
  </form>

  <div class="search__results" data-search-results role="region" aria-live="polite"></div>
</dialog>
