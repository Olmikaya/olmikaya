---
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import "../styles/olmikaya.css";

interface Props {
  title: string;
  description: string;
  /** Which nav item is current. */
  current?: string;
  /** Which section slug is current, for the strip under the masthead. */
  currentSection?: string;
  /** Article pages hide the section strip; it is noise while reading. */
  showSections?: boolean;
  /** Keep a page out of search results — form landings, not editorial. */
  noindex?: boolean;
}

const { title, description, current, currentSection, showSections, noindex } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF8F0" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OLMIKAYA" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Ovo&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />

    {/*
      The boot screen. Inline and in the head on purpose: it has to run before
      the body paints, or the swap from the fallback face has already happened
      and there is nothing left to hide.

      Deliberately self-contained. It does NOT depend on olmikaya.js, because
      a screen that hides the page until a script arrives is a screen that
      hides the page forever when that script fails. It clears itself on
      document.fonts.ready, on window load, and on a 1.2s timer — whichever
      comes first — and only ever runs once per session, so ordinary
      navigation is never interrupted.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;

        try {
          if (sessionStorage.getItem("olmikaya.booted")) return;
        } catch (e) {
          return; /* storage blocked: skip it rather than risk showing it every page */
        }

        root.setAttribute("data-booting", "");

        var cleared = false;
        function done() {
          if (cleared) return;
          cleared = true;
          try { sessionStorage.setItem("olmikaya.booted", "1"); } catch (e) {}

          var el = document.querySelector("[data-boot]");
          if (el) el.setAttribute("data-done", "true");
          setTimeout(function () { root.removeAttribute("data-booting"); }, 500);
        }

        setTimeout(done, 1200);
        window.addEventListener("load", done);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { setTimeout(done, 60); });
        }
      })();
    </script>
  </head>

  <body>
    <div class="boot" data-boot aria-hidden="true">
      <p class="boot__mark">OLMIKAYA</p>
    </div>

    <Masthead
      current={current}
      currentSection={currentSection}
      showSections={showSections}
    />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline src="/assets/js/olmikaya.js"></script>
  </body>
</html>
