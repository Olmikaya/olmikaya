---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Plate from "../components/Plate.astro";
import Subscribe from "../components/Subscribe.astro";
import { readingTime } from "../lib/reading-time";
import { publishedArticles, sections, categoriesOf } from "../lib/sections";

const articles = await publishedArticles();
const lead = articles.find((a) => a.data.featured) ?? articles[0];
const secondaries = articles.filter((a) => a.id !== lead?.id);

const allSections = await sections();

const entries = (await getCollection("directory", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const objects = (await getCollection("objects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const seasons = (await getCollection("seasons", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.index - b.data.index,
);

const dateOf = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
const mins = (a: (typeof articles)[number]) =>
  a.data.readingTime ?? readingTime(a.body ?? "");
---

<Base
  title="OLMIKAYA — Ordinary Living Made Intentional"
  description="An independent East African editorial and lifestyle company. People, places, objects, food, style, design, architecture, travel, work and everyday ritual."
>
  <div class="wrap">
    <!-- ================================================================
         THE BELIEF
         Compressed to a single band. The worldview still opens the page,
         but it no longer occupies a whole screen before any journalism.
         ================================================================ -->
    <section class="module module--first module--tight">
      <h1 class="statement">
        Ordinary life is worth experiencing intentionally.
      </h1>
    </section>

    <!-- ================================================================
         LEAD
         ================================================================ -->
    <section class="module">
      <div class="module-head">
        <h2 class="module-head__title">The lead</h2>
        <a class="more" href="/journal/">All stories</a>
      </div>

      {
        lead && (
          <div class="lead-block">
            <a class="tile__link reveal" href={`/journal/${lead.id}/`}>
              <Plate
                bare
                src={lead.data.cover.src}
                alt={lead.data.cover.alt}
                tone={lead.data.cover.tone}
                ratio="landscape"
              />
              <p class="tile__kicker">{categoriesOf(lead).join(" · ")}</p>
              <h3 class="lead-block__title">{lead.data.title}</h3>
              <p class="lead">{lead.data.dek}</p>
              <p class="tile__meta">
                <span>{lead.data.author}</span>
                <span>{lead.data.place}</span>
                <span>{dateOf(lead.data.date)}</span>
                <span>{mins(lead)} min</span>
              </p>
            </a>

            <div class="lead-block__aside briefs reveal">
              {secondaries.map((a) => (
                <a class="brief" href={`/journal/${a.id}/`}>
                  <div class="stack-sm">
                    <p class="tile__kicker">{categoriesOf(a).join(" · ")}</p>
                    <h3 class="brief__title">{a.data.title}</h3>
                    <p class="brief__meta">
                      <span>{a.data.author}</span>
                      <span>{a.data.place}</span>
                      <span>{mins(a)} min</span>
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <!-- ================================================================
         SECTIONS
         ================================================================ -->
    <section class="module module--tight">
      <div class="module-head">
        <h2 class="module-head__title">Sections</h2>
        <a class="more" href="/sections/">All sections</a>
      </div>

      <div class="grid-dense grid-dense--4 grid-dense--ruled reveal">
        {
          allSections.map((s) => (
            <a class="tile__link" href={`/sections/${s.slug}/`}>
              <p class="tile__kicker">
                {s.count} {s.count === 1 ? "piece" : "pieces"}
              </p>
              <h3 class="tile__title">{s.name}</h3>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         DIRECTORY
         ================================================================ -->
    <section class="module">
      <div class="module-head">
        <h2 class="module-head__title">People &amp; places</h2>
        <a class="more" href="/directory/">The directory</a>
      </div>

      <div class="grid-dense grid-dense--3 reveal">
        {
          entries.map((e, i) => (
            <div class="brief brief--top">
              <div class="stack-sm">
                <p class="tile__kicker">
                  {String(i + 1).padStart(3, "0")} · {e.data.city}
                </p>
                <h3 class="brief__title">{e.data.name}</h3>
                <p class="card__dek">{e.data.dek}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         OBJECTS
         ================================================================ -->
    <section class="module">
      <div class="module-head">
        <h2 class="module-head__title">Objects</h2>
        <a class="more" href="/shop/">All objects</a>
      </div>

      <div class="grid-dense grid-dense--4 grid-dense--ruled reveal">
        {
          objects.map((o) => (
            <a class="tile__link" href="/shop/">
              <Plate
                bare
                src={o.data.cover.src}
                alt={o.data.cover.alt}
                tone={o.data.cover.tone}
                ratio="square"
              />
              <h3 class="tile__title">{o.data.name}</h3>
              <p class="tile__meta">
                <span>{o.data.availability}</span>
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         SEASONS
         ================================================================ -->
    <section class="module">
      <div class="module-head">
        <h2 class="module-head__title">The seasons</h2>
        <a class="more" href="/seasons/">How seasons work</a>
      </div>

      <div class="grid-dense grid-dense--4 grid-dense--ruled reveal">
        {
          seasons.map((s) => (
            <a class="tile__link" href="/seasons/">
              <p class="season__index">{String(s.data.index).padStart(2, "0")}</p>
              <h3 class="tile__title">{s.data.title}</h3>
              <p class="tile__meta">
                <span>{s.data.dates}</span>
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <Subscribe />
</Base>
