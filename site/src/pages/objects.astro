---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Plate from "../components/Plate.astro";
import Subscribe from "../components/Subscribe.astro";

const objects = (await getCollection("objects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Objects — OLMIKAYA"
  description="A small number of things, made slowly, with the people we write about. Not yet for sale."
  current="objects"
>
  {/*
    The original brief was truncated mid-sentence at "Products should feel
    like", so the intended product positioning never arrived. This page takes
    the most conservative reading consistent with the rest of the brand:
    objects are extensions of the reporting, presented editorially, with no
    commerce mechanics and no invented prices.
  */}

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="col-7 stack reveal">
          <p class="eyebrow">Objects</p>
          <h1 class="display-l">Made with the people we write about.</h1>
          <p class="lead">
            We are not a shop that publishes. We are a journal that occasionally
            makes something, with the maker named on it, when there is a good
            reason to. There will never be many.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap">
      <div class="grid">
        <div class="col-8 reveal">
          <p class="note">
            <strong>Nothing is for sale yet.</strong> These objects are
            placeholders that establish how product will be presented. There is
            no cart, no checkout and no payment processing anywhere on this site,
            and no prices are shown because none have been set.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row row--2">
        {
          objects.map((o) => (
            <article class="object reveal">
              <Plate
                src={o.data.cover.src}
                alt={o.data.cover.alt}
                tone={o.data.cover.tone}
                ratio={o.data.cover.ratio}
                caption={o.data.cover.caption}
                credit={o.data.cover.credit}
              />

              <div class="object__head">
                <h2 class="object__name">{o.data.name}</h2>
                <p class="object__price">{o.data.availability}</p>
              </div>
              <p class="object__note">{o.data.note}</p>
              {o.data.maker && (
                <p class="small credit">Made with {o.data.maker}</p>
              )}
              {o.data.relatedArticle && (
                <a class="more" href={`/journal/${o.data.relatedArticle}/`}>
                  Read the story
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ground-cream">
    <div class="wrap">
      <div class="grid">
        <div class="col-4 stack reveal">
          <p class="eyebrow">Method</p>
          <h2 class="h2">How anything gets made</h2>
        </div>

        <div class="col-7 start-6 reveal">
          <div class="prose">
            <p>
              An object only exists because a story came first. We do not design
              a product and then find someone to make it; we write about someone,
              and occasionally that turns into something you can hold.
            </p>
            <p>
              The maker is named on the object and paid a share, not a fee. Runs
              are small and finite. When a run is gone it is gone, and nothing is
              reissued to meet demand.
            </p>
            <p>
              If we cannot make something better than what the maker already
              sells, we do not make it, and we point you at theirs instead.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Subscribe />
</Base>
