---
import Base from "../../layouts/Base.astro";

/* Where Kit sends a reader after they click Confirm in the confirmation
   email. Set as the redirect on the form's Incentive Email settings — see
   the form design in README.md.

   Distinct from thank-you.astro on purpose. That page is reached the moment
   an address is submitted, when the subscription is still pending; this one
   is reached only once it is real. */
---

<Base
  title="You are on the list — OLMIKAYA"
  description="Your subscription to the OLMIKAYA letter is confirmed."
  current="letter"
  showSections={false}
  noindex
>
  {/*
    Reachable only by following the link in Kit's confirmation email, so
    arriving here IS the confirmation. The script picks this up and remembers
    it, which is what stops the sign-up module pitching at this browser again.
  */}
  <div data-letter-confirmed hidden></div>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="col-7 stack reveal">
          <p class="eyebrow">The letter</p>
          <h1 class="display-l">That is confirmed.</h1>
          <p class="lead">
            The next letter reaches you at the close of the month.
          </p>
          <p class="small">
            <a class="link" href="/letter/">Past letters</a> ·
            <a class="link" href="/journal/">The journal</a> ·
            <a class="link" href="/directory/">The directory</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
