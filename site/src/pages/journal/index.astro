---
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import Subscribe from "../../components/Subscribe.astro";
import { readingTime } from "../../lib/reading-time";
import { publishedArticles, sections, categoriesOf } from "../../lib/sections";

const all = await publishedArticles();
const allSections = await sections();

/* The lead is whatever is flagged featured, falling back to the newest. */
const lead = all.find((a) => a.data.featured) ?? all[0];
const rest = all.filter((a) => a.id !== lead?.id);

const dateOf = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
const mins = (a: (typeof all)[number]) =>
  a.data.readingTime ?? readingTime(a.body ?? "");
---

<Base
  title="Journal — OLMIKAYA"
  description="Stories on people, places, objects, food, style, design, architecture, travel, work and everyday ritual across East Africa."
  current="journal"
>
  <div class="wrap">
    <section class="module module--first module--tight">
      <div class="module-head">
        <h1 class="module-head__title">The journal</h1>
        <p class="small muted">
          {all.length} {all.length === 1 ? "piece" : "pieces"}
        </p>
      </div>

      {
        lead && (
          <div class="lead-block">
            <a class="tile__link reveal" href={`/journal/${lead.id}/`}>
              <Plate
                bare
                src={lead.data.cover.src}
                alt={lead.data.cover.alt}
                tone={lead.data.cover.tone}
                ratio="landscape"
              />
              <p class="tile__kicker">{categoriesOf(lead).join(" · ")}</p>
              <h2 class="lead-block__title">{lead.data.title}</h2>
              <p class="lead">{lead.data.dek}</p>
              <p class="tile__meta">
                <span>{lead.data.author}</span>
                <span>{lead.data.place}</span>
                <span>{dateOf(lead.data.date)}</span>
                <span>{mins(lead)} min</span>
              </p>
            </a>

            {rest.length > 0 && (
              <div class="lead-block__aside briefs reveal">
                {rest.map((a) => (
                  <a class="brief" href={`/journal/${a.id}/`}>
                    <div class="stack-sm">
                      <p class="tile__kicker">{categoriesOf(a).join(" · ")}</p>
                      <h3 class="brief__title">{a.data.title}</h3>
                      <p class="brief__meta">
                        <span>{a.data.author}</span>
                        <span>{dateOf(a.data.date)}</span>
                        <span>{mins(a)} min</span>
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        )
      }
    </section>

    <!-- Everything, as a dense grid. -->
    <section class="module">
      <div class="module-head">
        <h2 class="module-head__title">Everything</h2>
        <a class="more" href="/sections/">By section</a>
      </div>

      <div class="grid-dense grid-dense--4 grid-dense--ruled">
        {
          all.map((a) => (
            <article class="tile reveal">
              <a class="tile__link" href={`/journal/${a.id}/`}>
                <Plate
                  bare
                  src={a.data.cover.src}
                  alt={a.data.cover.alt}
                  tone={a.data.cover.tone}
                  ratio="portrait"
                />
                <p class="tile__kicker">{categoriesOf(a).join(" · ")}</p>
                <h3 class="tile__title">{a.data.title}</h3>
                <p class="card__dek">{a.data.dek}</p>
                <p class="tile__meta">
                  <span>{a.data.author}</span>
                  <span>{mins(a)} min</span>
                </p>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Sections, as a way sideways. -->
    <section class="module module--tight">
      <div class="module-head">
        <h2 class="module-head__title">By section</h2>
        <a class="more" href="/sections/">All sections</a>
      </div>

      <div class="subnav__inner">
        {
          allSections.map((s) => (
            <a class="subnav__link" href={`/sections/${s.slug}/`}>
              {s.name} <span class="faint">{s.count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <Subscribe />
</Base>
