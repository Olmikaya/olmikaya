---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import Subscribe from "../../components/Subscribe.astro";

const all = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/* The lead is whatever is flagged featured, falling back to the newest. */
const lead = all.find((a) => a.data.featured) ?? all[0];
const rest = all.filter((a) => a.id !== lead?.id);
---

<Base
  title="Journal — OLMIKAYA"
  description="Stories on people, places, objects, food, style, design, architecture, travel, work and everyday ritual across East Africa."
  current="journal"
>
  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="col-7 stack reveal">
          <p class="eyebrow">The journal</p>
          <h1 class="display-l">Close attention, published slowly.</h1>
          <p class="lead">
            Reporting on the ordinary parts of contemporary East African life —
            the meal, the commute, the doorway, the cloth. We publish when a
            piece is ready, which is not often.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    lead && (
      <section class="section--tight">
        <div class="wrap">
          <div class="feature feature--flip reveal">
            <Plate
              src={lead.data.cover.src}
              alt={lead.data.cover.alt}
              tone={lead.data.cover.tone}
              ratio="landscape"
              caption={lead.data.place}
              credit={lead.data.cover.credit}
            />

            <div class="feature__body">
              <p class="eyebrow">
                {lead.data.category}
                {lead.data.secondaryCategory && ` · ${lead.data.secondaryCategory}`}
              </p>
              <h2 class="display-l">
                <a class="card__link" href={`/journal/${lead.id}/`}>
                  {lead.data.title}
                </a>
              </h2>
              <p class="lead">{lead.data.dek}</p>
              <p class="meta">
                <span>Words by {lead.data.author}</span>
                <span>
                  {lead.data.date.toLocaleDateString("en-GB", {
                    month: "long",
                    year: "numeric",
                  })}
                </span>
                {lead.data.readingTime && <span>{lead.data.readingTime} min read</span>}
              </p>
              <a class="more" href={`/journal/${lead.id}/`}>
                Read the story
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">Everything else</h2>
        <p class="small muted">
          {rest.length} {rest.length === 1 ? "piece" : "pieces"}
        </p>
      </div>

      <div class="row row--3">
        {
          rest.map((a) => (
            <article class="card reveal">
              <a class="card__link" href={`/journal/${a.id}/`}>
                <Plate
                  bare
                  src={a.data.cover.src}
                  alt={a.data.cover.alt}
                  tone={a.data.cover.tone}
                  ratio="portrait"
                />
                <div class="stack-sm">
                  <p class="eyebrow eyebrow--muted">
                    {a.data.category}
                    {a.data.secondaryCategory && ` · ${a.data.secondaryCategory}`}
                  </p>
                  <h3 class="card__title">{a.data.title}</h3>
                  <p class="card__dek">{a.data.dek}</p>
                  <p class="meta">
                    <span>{a.data.author}</span>
                    {a.data.readingTime && <span>{a.data.readingTime} min</span>}
                  </p>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <p class="note reveal hang">
        <strong>Placeholder editorial.</strong> These stories, bylines and
        reading times are written as scaffolding to prove the layout. They are
        not real reporting, and the bylines are invented. Replace them with
        commissioned work before this site goes anywhere public.
      </p>
    </div>
  </section>

  <Subscribe />
</Base>
