---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";

const seasons = (await getCollection("seasons", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.index - b.data.index,
);

/* The five parts of a season, in the order a reader meets them. Reader-facing
   copy: what each part IS, not how it is typeset or where it lives in the
   build. `where` names the part of the site it surfaces in, and links there
   when that is a real destination. */
const STRUCTURE = [
  {
    name: "The question",
    dek: "One line the whole season answers to. It is set before anything is commissioned, and it does not change once the season is running.",
    where: "Opening",
  },
  {
    name: "The stories",
    dek: "Everything commissioned under the season, in the order it was published.",
    where: "Journal",
    href: "/journal/",
  },
  {
    name: "The people and places",
    dek: "Every directory entry added while the season ran, and what earned it a place.",
    where: "Directory",
    href: "/directory/",
  },
  {
    name: "The objects",
    dek: "Whatever was made with the people the season covered, in the cases where something was worth making.",
    where: "Shop",
    href: "/shop/",
  },
  {
    name: "The closing note",
    dek: "What the question turned up, and where we were wrong about it. Written once the season has closed.",
    where: "Closing",
  },
];
---

<Base
  title="Seasons — OLMIKAYA"
  description="OLMIKAYA publishes in seasons. Each one sets a question, and everything made under it answers to that question."
  current="seasons"
>
  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="col-7 stack reveal">
          <p class="eyebrow">Seasons</p>
          <h1 class="display-l">Everything we make answers to a season.</h1>
          <p class="lead">
            A season sets a question. For as long as it runs, the stories we
            commission, the people we add to the directory and the objects we
            make are all answers to it. When the question is exhausted, the
            season closes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">The seasons</h2>
        <p class="small muted">
          {seasons.length} {seasons.length === 1 ? "season" : "seasons"}
        </p>
      </div>

      <div class="row row--2">
        {
          seasons.map((s) => (
            <article class="season reveal">
              <p class="season__index">{String(s.data.index).padStart(2, "0")}</p>
              <h3 class="season__title">{s.data.title}</h3>
              <p class="card__dek">{s.data.question}</p>
              {s.data.dates && (
                <p class="meta">
                  <span>{s.data.dates}</span>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ground-cream">
    <div class="wrap">
      <div class="grid">
        <div class="col-5 stack reveal">
          <p class="eyebrow">Structure</p>
          <h2 class="h2">What a season carries</h2>
          <p class="small muted">
            Five parts, in the order a reader meets them.
          </p>
        </div>

        <div class="col-6 start-7 reveal">
          {
            STRUCTURE.map((row, i) => (
              <div class="entry">
                <p class="entry__no">{String(i + 1).padStart(2, "0")}</p>
                <div class="stack-sm">
                  <h3 class="entry__name">{row.name}</h3>
                  <p class="card__dek">{row.dek}</p>
                </div>
                {row.href ? (
                  <a class="entry__place" href={row.href}>{row.where}</a>
                ) : (
                  <p class="entry__place">{row.where}</p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Subscribe />
</Base>
