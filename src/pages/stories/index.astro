---
import { getCollection } from "astro:content";
import Layout from "../../layouts/BlogPost.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("stories")).sort(
  (a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime()
);
---

<Layout title="All Stories" description="Explore all published stories">
  <main>
    <section>
      <h1>Stories</h1>
      {posts.length === 0 ? (
        <p>No stories published yet.</p>
      ) : (
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/stories/${post.id}/`}>
                <h4 class="title">{post.data.title}</h4>
                <p class="category">{post.data.category}</p>
                <p class="date">
                  <FormattedDate date={post.data.pubDate} />
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>
