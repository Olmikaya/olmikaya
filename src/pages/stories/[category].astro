---
import { getCollection } from "astro:content";
import Layout from "../../layouts/BlogPost.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export async function getStaticPaths() {
  const allStories = await getCollection("stories");
  
  if (!allStories || allStories.length === 0) {
    return [];
  }

  const categories = [...new Set(allStories.map((post) => (post.data.category || "General").toLowerCase()))];

  return categories.map((category) => {
    const filteredPosts = allStories.filter(
      (post) => (post.data.category || "General").toLowerCase() === category
    );
    return {
      params: { category },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { posts, categoryName } = Astro.props;
---

<Layout title={`Category: ${categoryName}`} description={`Stories tagged in ${categoryName}`}>
  <main>
    <section>
      <h1 style="text-transform: capitalize;">{categoryName}</h1>
      <ul>
        {posts && posts.map((post) => (
          <li>
            <a href={`/stories/${post.id}/`}>
              <h4 class="title">{post.data.title}</h4>
              <p class="date">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
