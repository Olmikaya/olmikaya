---
import Header from '../components/Header.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="container">
			<section class="hero-teaser">
				<p class="section-label">Volume I</p>
				<h2>Home of Ordinary Living Made Intentional</h2>
			</section>

			<section class="editorial-grid">
				<article class="grid-card">
					<p class="card-category">People</p>
					<h3>Crafting Space with Purpose</h3>
					<p class="card-excerpt">A look into intentional living environments across East Africa.</p>
				</article>

				<article class="grid-card">
					<p class="card-category">Spaces</p>
					<h3>Architectural Balance</h3>
					<p class="card-excerpt">How light, materials, and form establish tranquility at home.</p>
				</article>

				<article class="grid-card">
					<p class="card-category">Objects</p>
					<h3>Functional Permanence</h3>
					<p class="card-excerpt">Everyday items built to age with grace and longevity.</p>
				</article>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero-teaser {
		text-align: center;
		padding: 4rem 1rem 3rem;
		max-width: 800px;
		margin: 0 auto;
	}
	.section-label {
		font-family: var(--font-heading);
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-bottom: 0.75rem;
	}
	.hero-teaser h2 {
		font-size: 2.25rem;
		line-height: 1.3;
	}
	.editorial-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		padding-bottom: 5rem;
	}
	.grid-card {
		background: var(--color-card-bg);
		padding: 2rem;
		border: 1px solid var(--color-border);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.grid-card:hover {
		transform: translateY(-2px);
	}
	.card-category {
		font-family: var(--font-heading);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-muted);
		margin-bottom: 0.75rem;
	}
	.grid-card h3 {
		font-size: 1.35rem;
		margin-bottom: 0.5rem;
	}
	.card-excerpt {
		font-size: 0.9rem;
		color: var(--color-muted);
	}
</style>