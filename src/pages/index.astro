---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const rawStories = await getCollection('stories');
const stories = rawStories.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return dateB - dateA;
});

const featuredStory = stories[0];
const secondaryStories = stories.slice(1, 4);
---

<!html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero-statement reveal">
			<h2 class="mantra-title">
				<span class="line-block">Home of</span>
				<span class="line-block line-italic">Ordinary Living</span>
				<span class="line-block">Made Intentional.</span>
			</h2>
		</section>

		<main class="container-editorial">
			{featuredStory ? (
				<section class="hero-feature reveal">
					<a href={`/stories/${featuredStory.slug}`} class="editorial-card hero-link">
						<div class="img-wrap hero-image-container">
							<img 
								src={featuredStory.data.heroImage || "https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2000&auto=format&fit=crop"} 
								alt={featuredStory.data.title} 
								loading="lazy"
							/>
							<div class="inner-border-detail"></div>
						</div>

						<div class="hero-caption">
							<span class="tag-label">{featuredStory.data.category || 'People'}</span>
							<h3 class="hero-heading">{featuredStory.data.title}</h3>
							{featuredStory.data.description && (
								<p class="hero-text">{featuredStory.data.description}</p>
							)}
							<span class="read-button">Read Story</span>
						</div>
					</a>
				</section>
			) : (
				<section class="hero-feature reveal">
					<a href="/stories" class="editorial-card hero-link">
						<div class="img-wrap hero-image-container">
							<img src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2000&auto=format&fit=crop" alt="Ceramic studio" />
						</div>
						<div class="hero-caption">
							<span class="tag-label">People &mdash; Nairobi</span>
							<h3 class="hero-heading">The People Making Things Well</h3>
							<p class="hero-text">Inside the studios of three contemporary ceramicists redefining the texture of everyday Kenyan life...</p>
							<span class="read-button">Read Story</span>
						</div>
					</a>
				</section>
			)}

			<section class="discoveries-section">
				<div class="section-header reveal">
					<h2 class="section-title">Latest Discoveries</h2>
					<a href="/stories" class="view-all-link">View All</a>
				</div>

				<div class="discoveries-grid">
					{secondaryStories.length > 0 ? (
						secondaryStories.map((story) => (
							<article class="reveal editorial-card">
								<a href={`/stories/${story.slug}`} class="card-link">
									<div class="img-wrap aspect-4-3">
										<img src={story.data.heroImage || "https://images.unsplash.com/photo-1542361345-89e58247f2d5?q=80&w=1200&auto=format&fit=crop"} alt={story.data.title} />
									</div>
									<div class="card-content">
										<span class="tag-rust">{story.data.category}</span>
										<h3 class="card-title-lg">{story.data.title}</h3>
										{story.data.description && <p class="card-desc">{story.data.description}</p>}
									</div>
								</a>
							</article>
						))
					) : (
						<article class="col-main reveal editorial-card">
							<a href="/stories" class="card-link">
								<div class="img-wrap aspect-4-3">
									<img src="https://images.unsplash.com/photo-1542361345-89e58247f2d5?q=80&w=1200&auto=format&fit=crop" alt="Swahili architecture" />
								</div>
								<div class="card-content">
									<span class="tag-rust">Spaces &mdash; Lamu</span>
									<h3 class="card-title-lg">The Quiet Architecture of Coastal Swahili Homes</h3>
									<p class="card-desc">Observing the interplay of light, shadow, and carved plaster in spaces designed for slowness.</p>
								</div>
							</a>
						</article>
					)}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>