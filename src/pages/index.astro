---
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

let stories = [];
try {
  const rawStories = await getCollection("stories");
  stories = rawStories.sort((a, b) => {
    const parseTime = (d) => {
      if (!d) return 0;
      const t = new Date(d).getTime();
      return isNaN(t) ? 0 : t;
    };
    return parseTime(b.data.pubDate) - parseTime(a.data.pubDate);
  });
} catch (e) {
  console.error("Error loading collection:", e);
}

const featuredStory = stories.length > 0 ? stories[0] : null;
const secondaryStories = stories.length > 1 ? stories.slice(1, 4) : [];
---

<!html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="main-wrapper">
      <section class="hero-statement">
        <h2 class="mantra-title">
          <span>Home of</span>
          <span class="line-italic">Ordinary Living</span>
          <span>Made Intentional.</span>
        </h2>
      </section>

      {featuredStory ? (
        <section class="featured-story">
          <a href={`/stories/${featuredStory.slug}`} class="story-card-hero">
            <div class="img-wrap">
              <img 
                src={featuredStory.data.heroImage || "https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2000&auto=format&fit=crop"} 
                alt={featuredStory.data.title} 
              />
            </div>
            <div class="hero-content">
              <span class="category-tag">{featuredStory.data.category || "People"}</span>
              <h3 class="hero-title">{featuredStory.data.title}</h3>
              {featuredStory.data.description && <p>{featuredStory.data.description}</p>}
            </div>
          </a>
        </section>
      ) : (
        <section class="featured-story">
          <div class="story-card-hero">
            <div class="img-wrap">
              <img src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2000&auto=format&fit=crop" alt="Ceramic studio" />
            </div>
            <div class="hero-content">
              <span class="category-tag">People &mdash; Nairobi</span>
              <h3 class="hero-title">The People Making Things Well</h3>
              <p>Inside the studios of three contemporary ceramicists redefining everyday Kenyan design...</p>
            </div>
          </div>
        </section>
      )}

      <section class="discoveries">
        <h2 class="section-heading">Latest Discoveries</h2>
        <div class="grid-container">
          {secondaryStories.length > 0 ? (
            secondaryStories.map((story) => (
              <article class="grid-card">
                <a href={`/stories/${story.slug}`}>
                  <div class="img-wrap aspect">
                    <img src={story.data.heroImage || "https://images.unsplash.com/photo-1542361345-89e58247f2d5?q=80&w=1200&auto=format&fit=crop"} alt={story.data.title} />
                  </div>
                  <span class="category-tag">{story.data.category}</span>
                  <h3 class="card-heading">{story.data.title}</h3>
                </a>
              </article>
            ))
          ) : (
            <article class="grid-card">
              <div class="img-wrap aspect">
                <img src="https://images.unsplash.com/photo-1542361345-89e58247f2d5?q=80&w=1200&auto=format&fit=crop" alt="Coastal Architecture" />
              </div>
              <span class="category-tag">Spaces &mdash; Lamu</span>
              <h3 class="card-heading">The Quiet Architecture of Swahili Homes</h3>
            </article>
          )}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .main-wrapper { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
  .hero-statement { text-align: center; padding: 3rem 0; }
  .mantra-title { font-family: var(--font-seasons, serif); font-size: 2.25rem; line-height: 1.3; display: flex; flex-direction: column; gap: 0.25rem; }
  .line-italic { font-style: italic; }
  .featured-story { margin-bottom: 4rem; }
  .story-card-hero { display: block; text-decoration: none; color: inherit; }
  .img-wrap { width: 100%; overflow: hidden; background: #f0f0f0; }
  .img-wrap img { width: 100%; height: 450px; object-fit: cover; display: block; }
  .aspect img { height: 260px; }
  .hero-content { padding: 1.5rem 0; }
  .category-tag { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: #8b263e; font-weight: 600; }
  .hero-title { font-family: var(--font-seasons, serif); font-size: 2rem; margin: 0.5rem 0; }
  .section-heading { font-family: var(--font-seasons, serif); font-size: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 0.5rem; }
  .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; }
  .grid-card a { text-decoration: none; color: inherit; }
  .card-heading { font-family: var(--font-seasons, serif); font-size: 1.25rem; margin-top: 0.5rem; }
</style>
