---
interface Props {
  date?: Date | string;
}

const { date } = Astro.props;
const validDate = date ? new Date(date) : new Date();
---

{
  !isNaN(validDate.getTime()) ? (
    <time datetime={validDate.toISOString()}>
      {validDate.toLocaleDateString("en-us", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })}
    </time>
  ) : null
}
